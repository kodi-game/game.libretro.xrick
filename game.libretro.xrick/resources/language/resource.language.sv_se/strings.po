msgctxt "Addon Summary"
msgid "Rick Dangerous (XRick)"
msgstr "Rick Dangerous (XRick)"

msgctxt "Addon Description"
msgid "XRick is an open source implementation of the legendary game [I]Rick Dangerous[/I]."
msgstr "XRick är en implementering med öppen källkod av det legendariska spelet [I]Rick Dangerous[/I]."

msgctxt "#30001"
msgid "Crop Borders"
msgstr "Beskär ramar"

msgctxt "#30005"
msgid "Remove the 32 pixels of empty padding either side of the game screen. Note: Cheat mode indicators will only be shown if cropping is disabled."
msgstr "Ta bort de 32 bildpunkterna med tom utfyllnad på var sida om spelskärmen. Obs: indikatorer för fuskläge visas endast när beskärning är inaktiverad."

msgctxt "#30006"
msgid "Cheats"
msgstr "Fusk"

msgctxt "#30007"
msgid "Configure internal trainer/cheat modes provided by the game engine."
msgstr "Konfigurera interna tränar- och fusklägen som spelmotorn tillhandahåller."

msgctxt "#30008"
msgid "Always have 6 bullets, 6 dynamite stick, 6 lives."
msgstr "Ha alltid 6 kulor, 6 dynamitgubbar och 6 liv."

msgctxt "#30009"
msgid "Nothing can kill Rick. Use with care. May break the game."
msgstr "Ingenting kan döda Rick. Använd med försiktighet. Kan göra spelet obrukbart."

msgctxt "#30010"
msgid "Highlight all entities on the game map."
msgstr "Markera alla objekt på spelkartan."

msgctxt "#30011"
msgid "Trainer Mode"
msgstr "Träningsläge"

msgctxt "#30012"
msgid "Invulnerability Mode"
msgstr "Osårbar"

msgctxt "#30013"
msgid "Expose Mode"
msgstr "Exponeringsläge"

