msgctxt "Addon Summary"
msgid "Rick Dangerous (XRick)"
msgstr "Rick Dangerous (XRick)"

msgctxt "Addon Description"
msgid "XRick is an open source implementation of the legendary game [I]Rick Dangerous[/I]."
msgstr "XRick je open source implementace legendární hry [I]Rick Dangerous[/I]."

msgctxt "#30001"
msgid "Crop Borders"
msgstr "Oříznout okraje"

msgctxt "#30002"
msgid "Cheat: Trainer Mode"
msgstr "Cheat: režim traineru"

msgctxt "#30003"
msgid "Cheat: Invulnerability Mode"
msgstr "Cheat: režim nezranitelnosti"

msgctxt "#30004"
msgid "Cheat: Expose Mode"
msgstr "Cheat: režim odhalení"

msgctxt "#30005"
msgid "Remove the 32 pixels of empty padding either side of the game screen. Note: Cheat mode indicators will only be shown if cropping is disabled."
msgstr "Odstranit 32 pixelů prázdného okraje po obou stranách herní obrazovky. Poznámka: Indikátory režimu cheatů se zobrazí pouze při vypnutém oříznutí."

msgctxt "#30006"
msgid "Cheats"
msgstr "Cheaty"

msgctxt "#30007"
msgid "Configure internal trainer/cheat modes provided by the game engine."
msgstr "Konfigurovat interní režimy traineru/cheatů poskytované herním enginem."

msgctxt "#30008"
msgid "Always have 6 bullets, 6 dynamite stick, 6 lives."
msgstr "Vždy mít 6 nábojů, 6 dynamitových tyčinek a 6 životů."

msgctxt "#30009"
msgid "Nothing can kill Rick. Use with care. May break the game."
msgstr "Nic nemůže Ricka zabít. Používejte opatrně. Hra se může rozbít."

msgctxt "#30010"
msgid "Highlight all entities on the game map."
msgstr "Zvýraznit všechny objekty na herní mapě."
